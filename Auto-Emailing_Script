function autoEmailMaterials(e) {
  // Configuration --> who the emails are sent to
  var ROVER_RECIPIENTS = "exampleEmail@WorcesterMA.gov";

  // Capture form submission data 
  var values = e ? e.namedValues : null;
  if (!values) {
    Logger.log("CRITICAL ERROR: No event payload received.");
    return;
  }
  
  Logger.log("Available Form Questions: " + Object.keys(values).join(", "));

  var parkSite = values['Select Park'] ? values['Select Park'][0] : null;
  var logType = values['Week'] ? values['Week'][0] : null;
  
  if (!parkSite || !logType) {
    Logger.log("CRITICAL ERROR: Could not find 'Select Park' or 'Week'.");
    return; 
  }
  
  var cleanLogType = logType.toString().trim();
  var rawActivities = "";

  // Dynamic question field resolution
  if (cleanLogType.includes("Weekly") || cleanLogType.includes("Recurring")) { 
    rawActivities = values['Select Weekly Activity'] ? values['Select Weekly Activity'][0] : ""; 
  } else if (cleanLogType === "Other") { 
    rawActivities = values['General Supplies / Other'] ? values['General Supplies / Other'][0] : ""; 
  } else {
    // Dynamically matches "Week 1", "Week 2", ... "Week 6"
    var weekMatch = cleanLogType.match(/Week\s*\d+/i);
    var questionKey = weekMatch ? "Select " + weekMatch[0] + " Activity" : "";
    rawActivities = (questionKey && values[questionKey]) ? values[questionKey][0] : "";
  }

  if (!rawActivities) {
    Logger.log("Exited safely: No matching activity selection found in the form data.");
    Logger.log("DIAGNOSTIC - The form passed the Week as: [" + cleanLogType + "]");
    return;
