  // Build a normalized (lowercase) catalog map for guaranteed case-insensitive matching
  var catalog = {};
  var catalogKeysByLength = [];
  
  for (var key in rawCatalog) {
    catalog[key.toLowerCase()] = rawCatalog[key];
    catalogKeysByLength.push(key);
  }
  
  // Sort catalog keys by length (longest first) to accurately match multi-word / comma titles
  catalogKeysByLength.sort(function(a, b) { return b.length - a.length; });

  // 4. Activity matching and HTML building
  var formattedActivityNames = "";
  var formattedMaterialsBody = "";

  if (cleanLogType === "Other") {
    formattedActivityNames = "General Supplies / Custom Request";
    formattedMaterialsBody = "<ul style='margin: 0; padding-left: 20px;'><li style='margin-bottom: 8px;'><strong>Custom Request:</strong> " + rawActivities + "</li></ul>";
  } else {
    var materialsHtmlList = [];
    var cleanActivityNames = [];
    var remainingText = rawActivities.toLowerCase();

    // Match catalog keys directly against raw response to safely handle titles with commas
    for (var k = 0; k < catalogKeysByLength.length; k++) {
      var originalKey = catalogKeysByLength[k];
      var lowerKey = originalKey.toLowerCase();

      if (remainingText.indexOf(lowerKey) !== -1) {
        cleanActivityNames.push(originalKey);
        var itemsNeeded = catalog[lowerKey];
        materialsHtmlList.push("<li style='margin-bottom: 8px;'><strong>" + originalKey + ":</strong> " + itemsNeeded + "</li>");
        // Remove matched key from search string to prevent false double-matches (e.g. Kickball inside Six Base Kickball)
        remainingText = remainingText.replace(lowerKey, "");
      }
    }

    // Fallback split match if no catalog key matched directly
    if (cleanActivityNames.length === 0) {
      var fallbackItems = rawActivities.split(/,\s*/);
      for (var f = 0; f < fallbackItems.length; f++) {
        var item = fallbackItems[f].trim();
        if (item) {
          cleanActivityNames.push(item);
          materialsHtmlList.push("<li style='margin-bottom: 8px;'><strong>" + item + ":</strong> No specialized items listed in system.</li>");
        }
      }
    }

    formattedActivityNames = cleanActivityNames.join(", ");
    formattedMaterialsBody = "<ul style='margin: 0; padding-left: 20px;'>" + materialsHtmlList.join("") + "</ul>";
  }

  // 5. Draft and send email
  var subject = "NEW SUPPLY REQUEST: " + parkSite + " [" + logType + "]";
  
  var htmlBody = "<div style='font-family: Arial, sans-serif; padding: 15px; border: 1px solid #ddd; border-radius: 5px; max-width: 600px;'>" +
